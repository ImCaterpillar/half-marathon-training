# Supabase server-side only. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Generate with: pnpm access:hash your-access-code
# Recommended format: sha256:<64-char-hex>
APP_ACCESS_CODE_HASH=sha256:replace-with-generated-hash
APP_TIMEZONE=Asia/Shanghai

# Production cookies are HttpOnly + Secure + SameSite=Lax.
# For local HTTP-only development, set this to true. Keep false/absent in Vercel.
ALLOW_INSECURE_DEV_COOKIE=true

AI_API_KEY=
AI_MODEL=
# Optional. Accepts either https://provider.example/v1 or a full /chat/completions endpoint.
AI_BASE_URL=
